# ==============================================================================
# Daily Sideproject Automation Agent Environment Configuration
# ==============================================================================

# [GitHub]
# GitHub Personal Access Token (Requires 'repo' scope for forking & commits)
# If left blank, the script will automatically attempt to read via `gh auth token`
GITHUB_TOKEN=
GITHUB_USERNAME=ecs7723158

# [Hugging Face]
# Optional Hugging Face User Access Token (increases rate limits)
HF_TOKEN=

# [Notion Integration]
# Notion Internal Integration Secret Token (starts with secret_...)
NOTION_API_KEY=
# Target Notion Database UUID (e.g., 32-character ID without dashes)
NOTION_DATABASE_ID=
# Target Notion Parent Page UUID (Alternative if you don't use a database)
NOTION_PAGE_ID=

# [Obsidian Vault]
# Absolute path to your local Obsidian vault folder
OBSIDIAN_VAULT_PATH=/Users/yi-fanshan/.gemini/antigravity-ide/scratch/github-daily-agent/knowledge_base/obsidian

# [LLM Architecture Synthesis]
# Optional: Gemini API Key for deep LLM analysis (falls back to built-in expert rule engine if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=
